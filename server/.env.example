# Server
PORT=3000
NODE_ENV=production

# JWT
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Database (PostgreSQL for production)
DATABASE_URL="postgresql://user:password@localhost:5432/fireworks"

# MQTT Broker
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Alibaba Cloud SMS
ALI_SMS_ACCESS_KEY_ID=your-access-key
ALI_SMS_ACCESS_KEY_SECRET=your-secret
ALI_SMS_SIGN_NAME=安万嘉烟花
ALI_SMS_TEMPLATE_CODE=SMS_XXXXXXXXX

# Alibaba Cloud Voice
ALI_VOICE_ACCESS_KEY_ID=your-access-key
ALI_VOICE_ACCESS_KEY_SECRET=your-secret
ALI_VOICE_TTS_CODE=TTS_XXXXXXXXX

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
